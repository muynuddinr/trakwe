# ==============================================================================
# TRACKWE — TELTONIKA FMC920 TELEMATICS GATEWAY CONFIGURATION
# ==============================================================================

# Application Operating Mode: live | demo
# live = Strict physical hardware mode (only real telemetry from authorized Teltonika trackers, honest empty states)
# demo = Showcase mode with simulated sample fleet
NEXT_PUBLIC_APP_MODE=live

# Network binding address for the Teltonika TCP socket server
# Use 0.0.0.0 on production cloud hosts to listen on all interfaces
TELTONIKA_TCP_HOST=0.0.0.0

# Port for physical Teltonika FMC920 trackers to connect via TCP
TELTONIKA_TCP_PORT=5027

# Internal port for live telemetry HTTP API & WebSocket server
TRACKING_WS_PORT=8088

# Public WebSocket URL used by the Trackwe frontend (proxied via Nginx on port 4173)
NEXT_PUBLIC_TRACKING_WS_URL=ws://50.62.182.143:4173/ws

# Public API Base URL used by the Trackwe frontend
NEXT_PUBLIC_TRACKING_API_URL=http://50.62.182.143:3000

# Explicitly authorized device IMEIs mapped to Trackwe vehicles (in-memory registry)
# Format: IMEI1:VEHICLE_ID1[:VEHICLE_NAME[:REGISTRATION]],IMEI2:VEHICLE_ID2...
# Physical FMC920 authorized device:
TRACKING_ALLOWED_IMEIS=864022089340664:v-dxb-01:Volvo FH16 Cold Carrier:Dubai A-10842

# Inactivity threshold in seconds before device is marked as OFFLINE / STALE
TRACKING_STALE_SECONDS=60

# Service runtime mode: development | production
TRACKING_MODE=production
