# ==============================================================================
# TRACKWE TELEMATICS PLATFORM — CONFIGURATION ENVIRONMENT TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (Production & Staging)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
# If left blank, Trackwe defaults to embedded SQLite persistence at .data/telematics.db
DATABASE_URL=postgresql://trackwe_admin:CHANGE_ME_PASSWORD@localhost:5432/trackwe_telematics

# SQLite Database File Path (Used when DATABASE_URL is not provided)
SQLITE_DB_PATH=.data/telematics.db

# ------------------------------------------------------------------------------
# 2. TELTONIKA FMC920 TCP INGESTION SERVICE
# ------------------------------------------------------------------------------
# Host interface and port on which the raw TCP socket listener binds
# WARNING: Keep bound to 127.0.0.1 or behind a firewall during local development
GPS_TCP_HOST=0.0.0.0
GPS_TCP_PORT=5027

# Inactivity timeout in milliseconds before a silent socket is terminated (default: 5 mins)
GPS_SOCKET_TIMEOUT_MS=300000

# Maximum permitted packet buffer size in bytes per socket connection (default: 64 KB)
GPS_MAX_BUFFER_SIZE_BYTES=65536

# Maximum concurrent device TCP socket connections
GPS_MAX_CONNECTIONS=1000

# ------------------------------------------------------------------------------
# 3. WEB APPLICATION & API SETTINGS
# ------------------------------------------------------------------------------
# Port for Next.js App Router web server
PORT=4173
HOST=0.0.0.0

# Base URL for API client requests
NEXT_PUBLIC_API_URL=http://localhost:4173

# ------------------------------------------------------------------------------
# 4. TELEMETRY & RETENTION SETTINGS
# ------------------------------------------------------------------------------
# Stale threshold in minutes before an uncommunicative device ignition is marked 'Stale'
IGNITION_STALE_THRESHOLD_MINUTES=10

# Retention window in days for historical raw AVL packets before archiving
TELEMETRY_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 5. OBSERVABILITY & SECURITY
# ------------------------------------------------------------------------------
# Minimum log severity for telematics communication events (INFO, WARN, ERROR)
LOG_LEVEL=INFO
NODE_ENV=development
